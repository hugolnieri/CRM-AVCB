NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional. Sem esta chave as notificacoes sao apenas registradas na tabela
# `notificacoes` e aparecem no painel administrativo como "so registrado" --
# nenhum e-mail sai, e nada quebra. Ver app/api/notificar/route.ts.
RESEND_API_KEY=
# Remetente verificado no provedor. Padrao: onboarding@resend.dev (so funciona
# para enviar ao e-mail dono da conta Resend).
NOTIFICACOES_REMETENTE=

# NUNCA prefixar com NEXT_PUBLIC_. Esta chave IGNORA RLS por completo -- no
# navegador ela daria a qualquer visitante acesso irrestrito ao banco.
#
# Usada apenas em app/api/equipe/route.ts, para criar acesso de colaborador e
# redefinir senha; ambas as operacoes exigem a API de admin do Supabase. Sem
# ela, a aba Equipe continua listando e trocando perfis, e so os botoes de
# criar/redefinir respondem com uma mensagem pedindo a variavel.
#
# Onde achar: painel do Supabase > Project Settings > API Keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=
